# Protect sensitive files from public access
<Files ".env">
  Require all denied
</Files>

<Files "*.ts">
  Require all denied
</Files>

<Files "package.json">
  Require all denied
</Files>

<Files "package-lock.json">
  Require all denied
</Files>

<Files "tsconfig.json">
  Require all denied
</Files>

<Files "knexfile.*">
  Require all denied
</Files>

# Block access to source directory
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^src/ - [F,L]
</IfModule>
